<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Music</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        body { min-height: 100vh; background: #101010; color: white; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .container { width: 100%; max-width: 430px; background: #191919; padding: 40px; border: 1px solid #303030; border-radius: 15px; }
        .logo { color: #1ed760; font-size: 25px; font-weight: bold; margin-bottom: 40px; }
        h1 { font-size: 30px; margin-bottom: 10px; }
        .subtitle { color: #888; font-size: 14px; margin-bottom: 35px; }
        .input-group { margin-bottom: 22px; }
        label { display: block; color: #ccc; font-size: 13px; margin-bottom: 10px; }
        input { width: 100%; padding: 15px; background: #252525; color: white; border: 1px solid #383838; border-radius: 8px; outline: none; font-size: 14px; }
        input:focus { border-color: #1ed760; }
        button { width: 100%; padding: 15px; background: #1ed760; color: #000; border: none; border-radius: 30px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        button:hover { background: #17bd50; }
        .signup { text-align: center; color: #888; font-size: 14px; margin-top: 28px; }
        .signup a { color: white; font-weight: bold; text-decoration: none; }
        .signup a:hover { color: #1ed760; }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">♫ MUSIC</div>

        <h1>Welcome Back</h1>
        <p class="subtitle">Login to continue enjoying your music.</p>

        <form action="/login" method="POST">
            <div class="input-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="Enter your email" required>
            </div>

            <div class="input-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Enter your password" required>
            </div>

            <button type="submit">Login</button>
        </form>

        <p class="signup">Don't have an account? <a href="/signup">Sign Up</a></p>
    </div>
</body>
</html>
 
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Admin | Music Pro</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        body { background: #101010; color: white; min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; }
        .form-container { width: 100%; max-width: 430px; background: #191919; border: 1px solid #303030; border-radius: 15px; padding: 35px; }
        .logo { color: #1ed760; font-size: 22px; font-weight: bold; margin-bottom: 30px; }
        h1 { font-size: 27px; margin-bottom: 10px; }
        .subtitle { color: #888; font-size: 14px; margin-bottom: 30px; }
        .input-group { margin-bottom: 20px; }
        label { display: block; font-size: 13px; margin-bottom: 9px; color: #ccc; }
        input { width: 100%; padding: 14px; background: #252525; border: 1px solid #383838; border-radius: 8px; color: white; outline: none; font-size: 14px; }
        input:focus { border-color: #1ed760; }
        button { width: 100%; padding: 14px; background: #1ed760; color: #000; border: none; border-radius: 25px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        button:hover { background: #17bd50; }
        .back { display: block; text-align: center; color: #aaa; text-decoration: none; font-size: 13px; margin-top: 22px; }
        .back:hover { color: white; }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="logo">♫ MUSIC PRO</div>
        <h1>Add New Admin</h1>
        <p class="subtitle">Create a new administrator account.</p>

        <form action="/admin/create" method="POST">
            <div class="input-group">
                <label>Full Name</label>
                <input type="text" name="name" placeholder="Enter admin name" required>
            </div>

            <div class="input-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="Enter admin email" required>
            </div>

            <div class="input-group">
                <label>Password</label>
                <input type="password" name="pass" placeholder="Create password" required>
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPass" placeholder="Confirm password" required>
            </div>

            <button type="submit">Create Admin Account</button>
        </form>

        <a href="/admin/pro" class="back">← Back to Dashboard</a>
    </div>
</body>
</html>
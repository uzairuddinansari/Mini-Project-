<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pro Membership</title>

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{min-height:100vh;background:#080808;color:#fff;display:flex;align-items:center;justify-content:center;padding:30px 15px}
.wrapper{width:100%;max-width:850px;display:grid;grid-template-columns:1fr 1.2fr;background:#111;border:1px solid #292929;border-radius:20px;overflow:hidden}
.info{padding:45px 35px;background:linear-gradient(145deg,#143d22,#101810);display:flex;flex-direction:column;justify-content:space-between}
.logo{font-size:24px;font-weight:800}
.logo span{color:#1ed760}
.info h1{font-size:43px;line-height:1.1;letter-spacing:-2px;margin:45px 0 18px}
.info h1 span{color:#1ed760}
.info p{color:#b6c5b8;line-height:1.7;font-size:14px}
.features{list-style:none;margin-top:30px}
.features li{margin:17px 0;color:#e0e8e1;font-size:14px}
.features li::before{content:"✓";color:#1ed760;margin-right:12px}
.form-area{padding:40px 35px}
.form-area h2{font-size:27px;margin-bottom:8px}
.subtitle{color:#888;font-size:13px;margin-bottom:28px}
.field{margin-bottom:18px}
.field label{display:block;font-size:13px;color:#ccc;margin-bottom:9px}
.field input,.field select{width:100%;padding:14px;background:#1b1b1b;border:1px solid #333;border-radius:8px;color:#fff;outline:none;font-size:14px}
.field input:focus,.field select:focus{border-color:#1ed760}
.field input::placeholder{color:#666}
.row{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.submit{width:100%;padding:15px;border:0;border-radius:30px;background:#1ed760;color:#000;font-weight:800;font-size:15px;cursor:pointer;margin-top:10px}
.submit:hover{background:#fff}
.back{display:block;text-align:center;color:#888;text-decoration:none;font-size:13px;margin-top:20px}
.back:hover{color:#fff}
@media(max-width:650px){.wrapper{grid-template-columns:1fr}.info{padding:30px}.info h1{font-size:35px;margin:25px 0 12px}.features{margin-top:15px}.form-area{padding:30px 22px}}
</style>
</head>

<body>
<div class="wrapper">

    <div class="info">
        <div>
            <div class="logo">SPOTIFY<span>.</span></div>
            <h1>Go beyond<br>the <span>ordinary.</span></h1>
            <p>Become a Pro member and experience music with more freedom and control.</p>

            <ul class="features">
                <li>Ad-free listening</li>
                <li>Unlimited skips</li>
                <li>High quality audio</li>
                <li>Offline music downloads</li>
                <li>Exclusive Pro features</li>
            </ul>
        </div>
        <p>PREMIUM MUSIC EXPERIENCE</p>
    </div>

    <div class="form-area">
        <h2>Join Pro Membership</h2>
        <p class="subtitle">Enter your details to continue.</p>

        <form action="/pro/upgrade" method="POST">

            <div class="field">
                <label>Full Name</label>
                <input type="text" name="fullName" placeholder="Enter your full name" required>
            </div>

            <div class="field">
                <label>Email Address</label>
                <input
    type="email"
    name="email"
    value="<%= user.email %>"
    readonly >
            </div>

            <div class="row">
                <div class="field">
                    <label>Phone Number</label>
                    <input type="tel" name="phone" placeholder="03XXXXXXXXX" required>
                </div>

                <div class="field">
                    <label>Country</label>
                    <select name="country" required>
                        <option value="">Select country</option>
                        <option value="Pakistan">Pakistan</option>
                        <option value="India">India</option>
                        <option value="UAE">UAE</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="field">
                <label>Membership Plan</label>
                <select name="plan" required>
                    <option value="monthly">Monthly Pro</option>
                </select>
            </div>

            <div class="field">
                <label>Payment Method</label>
                <select name="paymentMethod" required>
                    <option value="">Select payment method</option>
                    <option value="easypaisa">EasyPaisa</option>
                    <option value="jazzcash">JazzCash</option>
                    <option value="bank">Bank Transfer</option>
                </select>
            </div>

            <button type="submit" class="submit">Continue to Pro →</button>
        </form>

        <a href="/" class="back">← Back to Home</a>
    </div>

</div>
</body>
</html>